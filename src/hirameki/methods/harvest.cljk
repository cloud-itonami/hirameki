(ns hirameki.methods.harvest
  "hirameki 閃き — the self-growing patent harvest leg (G9 live, key-free).

  One tick: take the next un-exhausted seed, look it up on Google Patents,
  append the new bibliographic quads to the corpus journal, and grow the seed
  list from the patents that one cites. The corpus explores the citation graph
  by walking it.

  ## Where the residency lives, and why it moved

  Until 2026-08-10 this loop lived in `kotoba-lang/toshokan-patents` next to the
  parser. It ran 618 patents deep and then stopped on 2026-07-28 — nobody
  noticed for thirteen days, because a daemon inside a library repo is nobody's
  actor. kotoba-lang now holds the PARSER as a library
  (`toshokan-patents.sources.google-patents`, pure + one request) and this actor
  holds the LOOP, the seed policy, the cursor, and the gates.

  ## What is NOT here

  The seed frontier — queue discipline, citation growth, the migration off the
  old append-only shape, the cursor arithmetic, the on-disk shape of
  `seeds.edn`, the policy, and the corpus timestamp dialect — lives in
  `hirameki.methods.seed`. It is pure, and it moved out because
  `hirameki.edge.worker` (the Cloudflare Worker, a real cron on
  `23 1,7,13,19 * * *`) needs exactly that and none of the fetching: it used to
  reach into this namespace for arithmetic and inherit the network leg with it.

  So this namespace is the effectful half and owns one job: fetch a patent, walk
  the queue, write the files at the end of the run.

  ## Discipline

  - one lookup per tick, sequential, identifying User-Agent (in the library)
  - metadata only — never claims or specification text
  - a 404 is a normal outcome (dead citation), not an error: the pair is marked
    exhausted and the cursor moves on
  - `:max-seeds` bounds the frontier so a citation graph cannot grow unbounded

  ## Gates enforced here

  - **G6** the journal records what the page published, including inventors;
    the CORPUS BOUNDARY (`corpus.cljc`) is where person-level data is dropped.
    Nothing in this namespace derives a person-level aggregate.
  - **G3** fields are mirrored as disclosed, never re-judged.
  - **G8** no key, no credential, no account — this source needs none, which is
    the whole reason it was chosen over USPTO ODP and EPO OPS.

  Deterministic where it can be: `tick!` takes `retrieved-at` from the caller,
  so a replay writes the same quads."
  (:require [kotoba.lang.text :as str]
            [hirameki.methods.seed :as seed]
            [toshokan-patents.quad :as quad]
            [toshokan-patents.quad.fs :as qfs]
            [toshokan-patents.sources.google-patents :as gp]
            [kotoba.io :as io]
            [cljs.reader :as edn]))

;; ── effectful: one tick ──────────────────────────────────────────────────────
;;
;; `gp/lookup` returns a Promise here, so this half of the namespace is
;; asynchronous end to end and every step threads with `.then`.
;;
;; It used to sit inside `#?(:clj …)`, which is why this actor ran no tick at all
;; between 2026-08-30 and 2026-10-04. Neither host could reach it: the only one
;; that can LOAD a `.cljk` file is kbb's SCI engine, whose reader features are
;; pinned to `#{:org.babashka/nbb :cljs}`, so the whole gate was silently
;; elided and the documented `kbb -M -m` command answered "unable to resolve
;; symbol"; and the JVM probes `.clj`/`.cljc` only, so `clojure -M -m` never
;; found the namespace at all. There is therefore no `:clj` branch here to keep.

(defn pause
  "Wait `ms`, returning a Promise.

  The inter-request gap is the politeness floor for this source
  (`seed/default-policy`'s `:inter-request-sleep-ms`, the only place that number
  is written); it survives as a promise step rather than being dropped to make
  the loop shorter.

  **The executor's arguments are `(resolve, reject)`, in that order.** Naming
  them the other way round and calling the second makes every gap REJECT with
  `undefined`, which surfaces as a `TypeError` thrown by the error reporter
  itself two ticks into a run, with the cause nowhere in sight — measured
  2026-10-04, before this was fixed."
  [ms]
  (js/Promise. (fn [resolve _reject] (js/setTimeout resolve ms))))

(defn tick!
  "One harvest tick against a corpus journal. Returns a summary map.

  opts:
    :journal-dir   corpus journal directory (required)
    :seeds         the pending queue (required)
    :state         current state map (required)
    :policy        merged over `seed/default-policy`
    :retrieved-at  timestamp stamped into the quads (required — the caller
                   owns the clock, so a replay is reproducible)

  Writes the journal; does NOT write seeds/state/git — the caller does, so a
  failed write cannot leave the queue ahead of the data.

  Returns a Promise. A lookup failure is funnelled to `{:error …}` rather than
  left as a rejection: a `try` around the call cannot see a rejected Promise, so
  a network blip would kill the tick instead of deferring the seed."
  [{:keys [journal-dir seeds state policy retrieved-at]}]
  (let [policy (merge seed/default-policy policy)]
    (if-let [seed (seed/next-seed seeds)]
      (let [pid (:query seed)
            existing (qfs/read-sharded journal-dir "google-patents")
            entities (quad/entities existing)
            ;; ids there is no point queueing again: already in the corpus,
            ;; or known dead. This is what replaces the old `:exhausted` list.
            known (into (set (:dead state))
                        (map #(str/replace (str %) #"^gp:" ""))
                        entities)]
        (-> (gp/lookup pid)
            (.then (fn [rec] {:rec rec}))
            (.catch (fn [e] {:error (ex-message e)}))
            (.then (fn [{:keys [rec error]}]
                     (cond
                       error
                       ;; transient: rotate to the back rather than dropping the fact
                       ;; that it is still owed, and rather than retrying it at
                       ;; position 0 — otherwise one bad id blocks the loop forever
                       ;; while still reporting a healthy exit.
                       {:seeds (seed/defer-seed seeds seed)
                        :state (seed/record-tick state retrieved-at)
                        :new? false :patent-id pid :reason :fetch-failed
                        :error error}

                       (nil? rec)
                       {:seeds (seed/drop-seed seeds seed)
                        :state (seed/record-tick state retrieved-at :dead (str/upper (str pid)))
                        :new? false :patent-id pid :reason :not-found}

                       (contains? entities (:entity rec))
                       {:seeds (seed/grow-seeds (seed/drop-seed seeds seed) (:citations rec) known policy retrieved-at)
                        :state (seed/record-tick state retrieved-at)
                        :new? false :patent-id pid :reason :already-known
                        :citations (count (:citations rec))}

                       :else
                       (let [quads (gp/->quads (quad/next-tx existing) retrieved-at rec)]
                         ;; sharded: only the bounded active shard is rewritten, so
                         ;; the cost of a tick does not grow with corpus size.
                         (qfs/append-sharded! journal-dir "google-patents" quads)
                         {:seeds (seed/grow-seeds (seed/drop-seed seeds seed) (:citations rec)
                                             (conj known (str/upper (str pid))) policy retrieved-at)
                          :state (seed/record-tick state retrieved-at)
                          :quads (count quads)
                          :new? true :patent-id pid
                          :citations (count (:citations rec))
                      :entities (inc (count entities))}))))))
      (js/Promise.resolve
       {:seeds seeds
        :state (seed/record-tick state retrieved-at)
        :new? false :reason :frontier-empty}))))

;; ── file legs ────────────────────────────────────────────────────────────────

(defn read-edn-file [path default]
  (let [f (io/file path)]
    (if (io/exists? f) (edn/read-string (slurp f)) default)))

(defn write-edn-file! [path data comment]
  (spit (io/file path) (str ";; " comment "\n" (seed/render-edn data))))

(defn run-ticks!
  "N ticks against a corpus journal, persisting the queue and state at the end.

  `:dataset-repo` is the cloud-itonami/hirameki-patents checkout — the corpus
  is a separate, independently versioned repository (ADR-2606212200), so this
  actor writes into it rather than carrying the data itself.

  Migrates the old append-only seed shape on first run.

  **The queue is written only at the end of the run, and that is safe.** A crash
  mid-run leaves the journal ahead of `seeds.edn`, so the next run re-offers the
  seeds the lost run already fetched. `seed/migrate-state` drops them against the
  corpus — measured 2026-10-04 by injecting an already-harvested id at the queue
  head: it was reported as removed and never re-fetched. The rewind costs one
  queue slot and no request, because the corpus, not the cursor, is the record
  of what has been fetched. Writing per tick instead would only make
  `state.edn` describe the run rather than the corpus.

  **The loop is a self-call, not `loop`/`recur`.** `recur` cannot cross a
  Promise boundary, and every tick hands back a Promise, so a `recur` here
  would stop the loop after one tick and report it as a completed run. The
  tick counts this actor is run at (1 interactive, 20 per cron cycle) sit
  well inside the stack."
  [{:keys [ticks dataset-repo seeds-path state-path retrieved-at]
    :or {ticks 1 seeds-path "seeds.edn" state-path "state.edn"}}](when-not (seq dataset-repo)
    (throw (ex-info "dataset repo path required (--dataset or HIRAMEKI_DATASET_REPO)" {})))
  (let [journal-dir (str (io/file dataset-repo "80-data" "public"))]
    ;; **An unread tree is not an empty corpus.** Measured 2026-10-04: pointing
    ;; --dataset at a directory that exists but holds no journal made the run
    ;; succeed with exit 0 — it created a journal there, reported "corpus 1",
    ;; harvested a patent into the wrong repo, AND advanced this actor's real
    ;; state.edn past that patent, so it was never queued again. A scheduled
    ;; run with a mistyped path would do all four silently. Same rule as
    ;; hirameki-datalake-tick, which refuses for the same reason.
    (when (empty? (qfs/shard-paths journal-dir "google-patents"))
      (throw (ex-info (str "no google-patents journal under " journal-dir
                           " — refusing to treat an unread tree as an empty corpus; "
                           "check --dataset points at the hirameki-patents checkout")
                      {:dataset-repo dataset-repo :journal-dir journal-dir})))
    (let [harvested (into #{}
                          (map #(str/upper (str/replace (str %) #"^gp:" "")))
                          (quad/entities (qfs/read-sharded journal-dir "google-patents")))
          {:keys [seeds state dropped]} (seed/migrate-state
                                 (read-edn-file seeds-path {:policy {} :seeds []})
                                 (read-edn-file state-path {:ticks 0})
                                 harvested)
          policy (merge seed/default-policy (:policy seeds))]
      (when (pos? dropped)
        (println (str "  · queue から " dropped " 件を除去"
                      "（作業済み / 取得済み）· dead " (count (:dead state)) " 件")))
      (letfn [(step [i q st results]
                (if (> i ticks)
                  (do (write-edn-file! seeds-path (assoc seeds :seeds q)
                                       "seeds.edn — pending frontier queue（daemon 管理 + 人手編集）")
                      (write-edn-file! state-path st
                                       "state.edn — daemon managed; do not hand-edit.")
                      ;; a Promise like every other step: the caller threads with .then
                      (js/Promise.resolve
                       {:ticks (count results)
                        :new (count (filter :new? results))
                        :queue (count q)
                        :dead (count (:dead st))
                        :results results}))
                  (-> (tick! {:journal-dir journal-dir :seeds q :state st
                              :policy policy
                              :retrieved-at (or retrieved-at (seed/now-iso))})
                      (.then (fn [r]
                           (println (str "  ♦ tick " i "/" ticks " " (:patent-id r)
                                         (if (:new? r)
                                           (str " → +" (:quads r) " quads, " (:citations r) " citations"
                                                " (corpus " (:entities r) ")")
                                           (str " → " (name (or (:reason r) :no-op))))
                                         " · queue " (count (:seeds r))))
                         ;; the politeness floor lives in the policy, not a flag
                         (let [ms (:inter-request-sleep-ms policy)]
                           (-> (pause (if (and ms (< i ticks)) ms 0))
                                 (.then (fn [_]
                                          (step (inc i) (:seeds r) (:state r)
                                                (conj results r)))))))))))]
        (step 1 (vec (:seeds seeds)) state [])))))
