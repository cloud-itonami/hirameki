{:paths ["src"]
 :deps {
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "d5259f35ab7c4f5a66e63ca29ed4dcf7ba3f1ac5"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "f74e248f0a07e8ae572885f50fab6bdb39dc24be"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/json {:git/sha "4c55a247b020bfb1c7b5b09f9df8f3fa5601a207"}
       com.junkawasaki/multiformats-clj
        {:git/url "https://github.com/com-junkawasaki/multiformats-clj.git"
         :git/sha "0f4ed68ff9e3cbf069569d897c9304713a14036c"}

        com.etzhayyim/kotoba-datom
        {:git/url "https://github.com/etzhayyim/com-etzhayyim-kotoba-datom"
         :git/sha "3c4b3b92234e59ba285119fd8b2ca4c2ee172ff8"}

        com.etzhayyim/social-publication
        {:git/url "https://github.com/etzhayyim/com-etzhayyim-social-publication"
         :git/sha "e8127d0661284b1c12ce1b216c84b5ed2db619ab"}

        ;; the patent parser — pure HTML→field-map + one polite request.
        ;; kotoba-lang holds the library; the loop that calls it lives here.
        io.github.kotoba-lang/toshokan-patents
        {:git/url "https://github.com/kotoba-lang/toshokan-patents"
         :git/sha "e26948e2e336385e9865fed49044d05c264bceb3"}

        ;; USPTO ODP responses only (ingest.cljc). The Google Patents leg needs
        ;; no JSON and no HTTP dependency at all.
}

 :aliases
 {;; :cljs — the Cloudflare Worker build (shadow-cljs). The Worker shares `src`
  ;; with the JVM actor on purpose: the pure harvest functions and the parser
  ;; are .cljc, so there is one seed policy and one journal format, not two.
  :cljs {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.20"}}}

  ;; the test namespaces are `hirameki.methods.test-*`, not `*-test`, so the
  ;; runner's default `.*-test$` matches nothing and reports a cheerful 0 tests.
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner" "-r" "hirameki\\.methods\\.test-.*"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
